# Database Configuration - PostgreSQL (Vercel Postgres)
# Obtén estas variables desde: Vercel Dashboard > Storage > Postgres Database > .env.local tab
DATABASE_URL="postgresql://username:password@host/database"
DIRECT_URL="postgresql://username:password@host/database"

# JWT Authentication
# Genera un secret seguro con: openssl rand -base64 32
JWT_SECRET="your-secret-key-minimum-32-characters-long"

# Environment
NODE_ENV="production"

# NextAuth (opcional si usas NextAuth en lugar de JWT manual)
NEXTAUTH_URL="https://your-domain.vercel.app"
NEXTAUTH_SECRET="your-nextauth-secret-key"

# Admin Credentials (CAMBIAR EN PRODUCCIÓN)
ADMIN_PASSWORD="change-this-in-production"
